{
  "multipart": [
    {
      "when": { "north": "true" },
      "apply": { "model": "theaurorian2:block/aurorian_vine" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "theaurorian2:block/aurorian_vine", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "theaurorian2:block/aurorian_vine", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "theaurorian2:block/aurorian_vine", "y": 270, "uvlock": true }
    },
    {
      "when": { "up": "true" },
      "apply": { "model": "theaurorian2:block/aurorian_vine", "x": 270, "uvlock": true }
    }
  ]
}
